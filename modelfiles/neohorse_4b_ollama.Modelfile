# Harness 2.0 — Challenger `neohorse_4b_ollama` (bake-off de RuntimeProfiles).
#
# Mesmos parâmetros do Modelfile do perfil funcional: num bake-off só o modelo
# muda. TEMPLATE, SYSTEM, renderer e parser vêm do artefato base.
FROM hf.co/TokenRhythm/NeoHorse-1-4B-GGUF:Q4_K_M

PARAMETER num_ctx 65536
PARAMETER temperature 0.3
PARAMETER presence_penalty 0
PARAMETER top_k 20
PARAMETER top_p 0.8
