# Meu Harness — Challenger `gemma4_e4b_q8_ollama` (harness-gemma4-e4b-q8).
#
# Os mesmos parâmetros do perfil core: no bake-off só a quantização muda
# (Q8_0 pós-treino contra o Q4_0 QAT). TEMPLATE, renderer e parser vêm da base.
FROM gemma4:e4b-it-q8_0

PARAMETER num_ctx 65536
PARAMETER temperature 0.3
PARAMETER presence_penalty 0
PARAMETER top_k 20
PARAMETER top_p 0.8
