# Meu Harness — Challenger `gemma4_12b_qat_ollama` (harness-gemma4-12b-qat).
#
# Os mesmos parâmetros do perfil core: no bake-off só o tamanho muda (12B denso
# contra o E4B, os dois Q4_0 QAT). TEMPLATE, renderer e parser vêm da base.
FROM gemma4:12b-it-qat

PARAMETER num_ctx 65536
PARAMETER temperature 0.3
PARAMETER presence_penalty 0
PARAMETER top_k 20
PARAMETER top_p 0.8
