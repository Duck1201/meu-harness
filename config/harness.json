{
  "schema_version": 2,
  "contract_version": "2.0.0",
  "normative_document": "docs/DECISOES-2.0.md",
  "release_pending_document": "docs/RELEASE-PENDING.md",
  "runtime_profiles": "config/model-profiles.json",
  "tool_registry": "config/tool-registry.json",
  "platform": {
    "python": "3.13",
    "operating_system": "linux",
    "architecture": "x86_64"
  },
  "default_runtime_profile": "local_mitos_ollama_reproduction",
  "default_execution_route": "local_web_tools",
  "execution_routes": [
    {
      "id": "local_web_tools",
      "status": "active",
      "runtime_profile": "local_mitos_ollama_reproduction",
      "surface": "web",
      "model_tools_collection": "model_tools",
      "sampling": {
        "temperature": 0.3,
        "presence_penalty": 0,
        "thinking": true
      },
      "streaming": false,
      "parallel_tool_execution": false,
      "reasoning_persistence": "transient_only",
      "limits_source": "loop"
    }
  ],
  "locale": {
    "model_facing_instructions": "en",
    "tool_names": "en_ascii_snake_case",
    "tool_descriptions": "en",
    "final_response": "pt-BR",
    "project_documentation": "pt-BR"
  },
  "policy": {
    "basis": "effects",
    "default": "deny",
    "grant_types": [
      "WorkspaceRootGrant",
      "WriteGrant",
      "WebAccessGrant",
      "CorpusGrant"
    ],
    "effect_grants": {
      "workspace_read": ["WorkspaceRootGrant"],
      "workspace_write": ["WorkspaceRootGrant", "WriteGrant"],
      "data_egress": ["WebAccessGrant"],
      "corpus_read": ["CorpusGrant"],
      "pure_compute": []
    },
    "grant_authority": "Operator",
    "model_cannot_grant_or_expand_access": true,
    "operator_confirmation": {
      "automation_id": "operator_confirmation",
      "basis": "effects",
      "effects_requiring_decision": ["workspace_write"],
      "effects_requiring_decision_under_taint": ["workspace_write", "data_egress"],
      "decision_scope": "single_call",
      "decision_grants": {
        "write_grant_required": "WriteGrant",
        "web_access_grant_required": "WebAccessGrant"
      },
      "taint_decision_never_creates_grant": true,
      "preview": "unified_diff_from_executor",
      "waiver": {
        "scope": "conversation",
        "effects": ["workspace_write"],
        "authority": "Operator",
        "revocable": true,
        "covers_tainted_calls": false
      },
      "yolo": {
        "scope": "global_with_conversation_opt_out",
        "default": false,
        "authority": "Operator",
        "revocable": true,
        "effects": ["workspace_write", "data_egress"],
        "covers_tainted_calls": true,
        "grants_on_approval": ["WriteGrant", "WebAccessGrant"],
        "records_decision_as": "waived",
        "decision_document": "docs/adr/0008-operator-yolo-mode.md"
      }
    }
  },
  "tool_exposure": {
    "source": "config/tool-registry.json",
    "collection": "model_tools",
    "dynamic_selection": false,
    "unknown_tool_error_lists_current_collection": true,
    "aliases_visible_to_model": false
  },
  "loop": {
    "max_steps": 15,
    "max_tool_calls_per_step": 4,
    "max_tool_calls_per_turn": 20,
    "max_read_calls_per_turn": 40,
    "max_turn_duration_seconds": 900,
    "model_generation_timeout_seconds": 300,
    "max_malformed_model_attempts": 2,
    "max_output_tokens": 8192,
    "stream_tool_calls": false,
    "parallel_tool_execution": false,
    "execute_calls_in_emission_order": true,
    "offer_tools_on_final_step": false,
    "persist_terminal_outcome_once": true,
    "replay_policy_source": "config/tool-registry.json#model_tools[*].replay_policy",
    "guards": "mechanical_state_transitions"
  },
  "outcomes": {
    "terminal_outcomes": [
      "completed",
      "limit_reached",
      "cancelled",
      "blocked",
      "failed",
      "abandoned"
    ],
    "reason_code_is_required": true,
    "task_verdicts": ["pass", "fail", "inconclusive", "not_evaluated"],
    "terminal_outcome_is_immutable": true,
    "task_verdict_never_overwrites_terminal_outcome": true
  },
  "state": {
    "canonical_history": "complete_durable_facts",
    "model_view": "derived_disposable",
    "ag_ui": "derived_projection",
    "rejected_attempts_remain_in_history": true,
    "reasoning": {
      "transient": true,
      "persist_to_canonical_history": false,
      "persist_to_telemetry": false,
      "available_in_replay": false
    }
  },
  "context": {
    "initial_budget_tokens": 65536,
    "max_tool_read_bytes": 32768,
    "max_tool_search_bytes": 32768,
    "budget_includes": [
      "system",
      "tool_schemas",
      "model_view",
      "tool_results",
      "reserved_output"
    ],
    "deduplicate_tool_results_by_content_hash": true,
    "extract_html_once": true,
    "code_compression": {
      "enabled": false,
      "status": "disabled_experimental"
    },
    "mechanical_prose_compression": false,
    "cut_oldest_model_view_blocks_to_budget": true
  },
  "corpus": {
    "effect": "corpus_read",
    "required_grant": "CorpusGrant",
    "grant_scope": "corpus_id",
    "automation_id": "corpus_retrieval",
    "store": {
      "kind": "sqlite",
      "one_file_per_corpus": true,
      "directory": "state_dir/corpora",
      "meta_lives_in_corpus_file": true,
      "reached_by_retention": false,
      "deleted_by": "operator_only"
    },
    "embedding": {
      "source": "config/model-profiles.json#runtime_profiles[*].embedding",
      "batch_size": 32
    },
    "ingestion": {
      "accepted_extensions": [".txt", ".md", ".html", ".pdf"],
      "html_extractor": "builtin",
      "reject_pdf_without_text_layer": true,
      "max_upload_bytes": 134217728,
      "cleaning": "deterministic_only",
      "model_written_text_is_never_indexed_as_fact": true,
      "chunk_target_tokens": 512,
      "chunk_overlap_tokens": 64,
      "chunk_minimum_tokens": 8,
      "chunk_boundary": "paragraph_or_heading_then_sentence_when_oversized",
      "context_prefix": "document_title_heading_path_and_page",
      "commit_unit": "document",
      "deduplicate_by": ["source_digest", "chunk_digest"]
    },
    "retrieval": {
      "dense_candidates": 40,
      "lexical_candidates": 40,
      "fusion": "reciprocal_rank",
      "reciprocal_rank_constant": 60,
      "floor_measured_on": "dense_cosine_similarity",
      "floor_applies_to": "every_injected_passage",
      "dense_similarity_floor": 0.53,
      "injected_passages": 6,
      "max_injected_tokens": 4000,
      "query_language_strategy": "dense_uses_operator_text_lexical_uses_both_operator_text_and_generated_query",
      "lexical_leg_without_generated_query": "operator_text_alone",
      "translate_documents": false,
      "empty_when_nothing_clears_floor": true
    },
    "scraper": {
      "authorized_by": "Operator",
      "requires_grant": false,
      "egress_guard": "same_as_web_fetch",
      "result_taint": "UntrustedWebTaint",
      "mediawiki": {
        "probe": "api.php",
        "list": "allpages",
        "extract": "extracts_explaintext",
        "page_batch": 1,
        "thin_extract_chars": 200,
        "thin_extract_fallback": "parse_rendered_html",
        "backoff_seconds": [5, 10, 20, 40, 80]
      },
      "html_crawl": {
        "same_registrable_domain_only": true,
        "respect_robots_txt": true,
        "prefer_sitemap": true,
        "max_depth": 3,
        "max_pages": 5000,
        "max_total_bytes": 2147483648,
        "delay_milliseconds": 1000,
        "browser_escalation": {
          "mode": "disabled",
          "thin_page_chars": 200,
          "stealth": false,
          "timeout_milliseconds": 30000,
          "egress_guard": "every_browser_request",
          "adr": "docs/adr/0014-corpus-browser-route-scrapling.md"
        }
      }
    },
    "jobs": {
      "transport": "polling_json",
      "statuses": [
        "queued",
        "running",
        "canceling",
        "canceled",
        "completed",
        "failed"
      ],
      "resume": "idempotent_redispatch",
      "resume_on_boot": false
    }
  },
  "workspace": {
    "model_visible_paths": "workspace_relative",
    "reject_absolute_paths": true,
    "reject_parent_traversal": true,
    "canonicalize_and_check_symlinks": true,
    "deny_outside_workspace": true
  },
  "page_verification": {
    "kind": "InternalAutomation",
    "automation_id": "page_verification",
    "mode": "disabled",
    "allowed_modes": [
      "disabled",
      "automatic_once_per_page_revision"
    ],
    "status": "experimental_not_promoted",
    "model_selectable": false,
    "page_revision_key_fields": [
      "workspace_id",
      "relative_path",
      "html_sha256",
      "workspace_revision",
      "verifier_digest"
    ],
    "inject_result_at_most_once": true,
    "promotion_experiment": "page_verification_once_per_page_revision"
  },
  "network": {
    "effect": "data_egress",
    "required_grant": "WebAccessGrant",
    "default": "deny",
    "allowed_schemes": ["http", "https"],
    "block_private_and_special_ranges": true,
    "revalidate_ssrf_policy_on_redirect": true,
    "web_search": {
      "provider": "searxng",
      "provider_endpoint_declared_by": "Operator",
      "fallback": "duckduckgo_lite",
      "declared_endpoint_may_be_private": true
    },
    "web_fetch": {
      "initial_engine": "http",
      "browser_escalation": "internal_by_symptom",
      "empty_extraction_threshold_chars": 120,
      "retry_seconds_for_incomplete_load": [5, 10, 20, 40, 80],
      "retry_blocked_or_denied": false,
      "cache_scope": "turn"
    },
    "browser": {
      "engine": "chromium",
      "context_lifetime": "single_operation",
      "separate_context_per_operation": true,
      "web_and_page_verification_contexts_separate": true,
      "share_cookies_storage_cache_or_service_workers": false
    },
    "eval_bench": {
      "purpose": "deterministic browser escalation evidence without a third-party site",
      "hostname": "bench.harness.test",
      "address": "127.0.0.1",
      "available_to_eval_tiers": ["model_smoke", "experiment"],
      "available_to_execution_routes": [],
      "implementation": "src/harness/evals/bench.py",
      "not_imported_by_application_path": true,
      "regression": "eval_bench_exception_is_not_available_in_production"
    },
    "web_results": {
      "taint": "UntrustedWebTaint",
      "propagate_to_derivations": true,
      "taint_never_grants_authority": true
    }
  },
  "stores": [
    {
      "id": "canonical_state",
      "kind": "sqlite",
      "implementation": "sqlite3_conversation_store",
      "stores_content": true,
      "stores_reasoning": false,
      "failure_is_fatal": true
    },
    {
      "id": "telemetry",
      "kind": "sqlite",
      "implementation": "local_metrics_store",
      "stores_content": false,
      "stores_reasoning": false,
      "external_export_enabled": false,
      "failure_is_fatal": false
    },
    {
      "id": "corpus",
      "kind": "sqlite",
      "implementation": "corpus_store",
      "one_file_per_corpus": true,
      "stores_content": true,
      "stores_reasoning": false,
      "stores_conversation_state": false,
      "failure_is_fatal": false
    }
  ],
  "retention": {
    "policy_scope": "global",
    "retention_days": null,
    "deletion_unit": "conversation",
    "partial_history_deletion": false,
    "per_conversation_override": false,
    "reaches_corpus_stores": false
  },
  "ui": {
    "delivery": "web_first",
    "protocol": "AG-UI",
    "projection_source": "canonical_state",
    "client": "react_ag_ui_spa",
    "theme": "light_only",
    "conversation_branching": false,
    "approve_with_edits": false
  },
  "evals": {
    "primary_surface": "web",
    "fixtures": "evals/fixtures/regressions.json",
    "experiments": "evals/experiments.json"
  },
  "roadmap": {
    "excluded_models": ["Qwen2.5-Coder-7B-Instruct"]
  }
}
